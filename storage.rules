rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Property images — authenticated users can read; managers/admins upload
    match /properties/{propertyId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB limit
                   && request.resource.contentType.matches('image/.*');
    }

    // User profile pictures
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024  // 2 MB limit
                   && request.resource.contentType.matches('image/.*');
    }

    // Lead attachments (documents, brochures)
    match /leads/{leadId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024;  // 25 MB limit
    }
  }
}
